# Required in production: generate a unique high-entropy value and keep it secret.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=hubsweida.jwtalenthouse.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://hubsweida.jwtalenthouse.com
# Production security controls (HTTPS is terminated by the existing Traefik proxy).
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
# Initial rollout: increase after monitoring, e.g. 86400, then 31536000. Keep
# includeSubDomains and preload disabled until every subdomain is HTTPS-ready.
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=True
DJANGO_SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
DJANGO_X_FRAME_OPTIONS=DENY
POSTGRES_DB=hub
POSTGRES_USER=hub
POSTGRES_PASSWORD=hub_strong_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
MIKROTIK_ENABLED=false
MIKROTIK_BASE_URL=
MIKROTIK_USERNAME=
MIKROTIK_PASSWORD=
MIKROTIK_VERIFY_TLS=true
MIKROTIK_CA_FILE=
MIKROTIK_CONNECT_TIMEOUT=5
MIKROTIK_READ_TIMEOUT=10
MIKROTIK_HOTSPOT_SERVER=
# HTTPS HotSpot login servlet used by the one-tap customer relay, e.g.
# https://wifi.hubsweida.local/login . Configure RouterOS login-by=https (or
# another HTTPS form-compatible method); CHAP-only/HTTP login is not accepted.
MIKROTIK_HOTSPOT_LOGIN_URL=
MIKROTIK_USER_PREFIX=hub-
MIKROTIK_DEFAULT_PROFILE=
# Fernet key generated once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MIKROTIK_CREDENTIAL_KEY=
# Duration applied when a regular reservation has no explicit end time.
RESERVATION_DEFAULT_DURATION_MINUTES=120
